# Configuration de base pour le backend Gérondy Shop
DATA_PATH=./data/gerondyshop.json
JWT_SECRET=gerondyshop-secret-2026
PORT=3000

# Optional SMTP settings to enable email notifications
# If not set, email sending will be skipped and logged instead.
# Example for SendGrid SMTP: host=smtp.sendgrid.net, port=587, user=apikey, pass=<SENDGRID_API_KEY>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# Admin email that receives concierge notifications (default: schekinacamille@gmail.com)
ADMIN_EMAIL=schekinacamille@gmail.com
